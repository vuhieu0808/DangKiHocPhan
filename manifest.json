{
  "manifest_version": 3,
  "name": "HCMUS Course Sniper VIP",
  "version": "2.0",
  "description": "Công cụ hỗ trợ đăng ký học phần HCMUS thông minh, an toàn và chính xác",
  "author": "vuhieu",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://portal.ctdb.hcmus.edu.vn/*"
  ]
}